{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                    "--build",
                    "build",
                    "--parallel"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run Game",
            "type": "shell",
            "command": ".\\build\\*.exe"
        }
    ]
}